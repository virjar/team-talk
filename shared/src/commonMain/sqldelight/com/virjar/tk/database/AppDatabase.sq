-- 发布前阶段本地库按 schema epoch 整库重建，不维护就地迁移。
-- 用户
CREATE TABLE IF NOT EXISTS user (
    uid TEXT PRIMARY KEY NOT NULL,
    username TEXT NOT NULL,
    name TEXT NOT NULL,
    avatar TEXT,
    phone TEXT,
    sex INTEGER DEFAULT 0,
    role INTEGER DEFAULT 0,
    status INTEGER DEFAULT 1
);

-- 联系人
CREATE TABLE IF NOT EXISTS contact (
    uid TEXT NOT NULL,
    friend_uid TEXT NOT NULL,
    remark TEXT,
    status INTEGER DEFAULT 1,
    PRIMARY KEY (uid, friend_uid)
);

-- 聊天
CREATE TABLE IF NOT EXISTS chat (
    chat_id TEXT PRIMARY KEY NOT NULL,
    chat_type INTEGER NOT NULL,
    name TEXT,
    avatar TEXT,
    creator TEXT,
    member_count INTEGER DEFAULT 0,
    max_seq INTEGER DEFAULT 0,
    notice TEXT,
    muted_all INTEGER DEFAULT 0
);

-- 群成员
CREATE TABLE IF NOT EXISTS member (
    chat_id TEXT NOT NULL,
    uid TEXT NOT NULL,
    role INTEGER DEFAULT 0,
    nickname TEXT,
    joined_at INTEGER DEFAULT 0,
    PRIMARY KEY (chat_id, uid)
);

-- 消息
CREATE TABLE IF NOT EXISTS message (
    chat_id TEXT NOT NULL,
    client_msg_id TEXT NOT NULL,
    server_seq INTEGER DEFAULT 0,
    sender_uid TEXT NOT NULL,
    message_type INTEGER NOT NULL,
    timestamp INTEGER NOT NULL,
    flags INTEGER DEFAULT 0,
    body BLOB,
    send_status INTEGER DEFAULT 0,
    PRIMARY KEY (chat_id, client_msg_id)
);
CREATE INDEX IF NOT EXISTS idx_message_chat_seq ON message(chat_id, server_seq);

-- 客户端发送事实源。payload 是入队时规范化后的完整 Message protobuf，之后不可改写。
-- state: 0=PENDING, 1=IN_FLIGHT, 2=RETRY_WAIT, 3=TERMINAL_FAILED, 4=SUCCESS。
-- SUCCESS 是有界持久回执；worker 只读取 active 状态，GC 只删除最老 SUCCESS。
CREATE TABLE IF NOT EXISTS outgoing_message (
    local_ordinal INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    client_msg_id TEXT NOT NULL,
    chat_id TEXT NOT NULL,
    payload BLOB NOT NULL,
    request_fingerprint BLOB,
    state INTEGER NOT NULL DEFAULT 0,
    attempt_count INTEGER NOT NULL DEFAULT 0,
    last_error TEXT,
    terminal_code INTEGER,
    server_seq INTEGER,
    next_attempt_at INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    completed_at INTEGER,
    UNIQUE(chat_id, client_msg_id)
);
CREATE INDEX IF NOT EXISTS idx_outgoing_ready
ON outgoing_message(state, next_attempt_at, local_ordinal);

-- 会话
CREATE TABLE IF NOT EXISTS conversation (
    chat_id TEXT PRIMARY KEY NOT NULL,
    chat_type INTEGER NOT NULL,
    chat_name TEXT,
    chat_avatar TEXT,
    last_seq INTEGER DEFAULT 0,
    read_seq INTEGER DEFAULT 0,
    peer_read_seq INTEGER DEFAULT 0,
    unread_count INTEGER DEFAULT 0,
    is_pinned INTEGER DEFAULT 0,
    is_muted INTEGER DEFAULT 0,
    draft TEXT,
    last_msg_timestamp INTEGER DEFAULT 0
);

-- 草稿本地写入与服务端镜像之间的持久化 outbox。
-- 表中无行：服务端草稿可以正常进入本地；有行且 draft IS NULL：用户明确清空。
-- state 0=PENDING（待 RPC），1=ACKED（RPC 成功，等待匹配的权威快照后清理）。
CREATE TABLE IF NOT EXISTS conversation_draft_outbox (
    chat_id TEXT PRIMARY KEY NOT NULL,
    draft TEXT,
    generation INTEGER NOT NULL,
    state INTEGER NOT NULL DEFAULT 0
);

-- 同步游标
CREATE TABLE IF NOT EXISTS sync_cursor (
    key TEXT PRIMARY KEY NOT NULL,
    value INTEGER NOT NULL
);

-- 无头客户端的持久业务 inbox。event_id 既保持投递顺序，也让 cursor 重放幂等。
CREATE TABLE IF NOT EXISTS bot_message_inbox (
    event_id INTEGER PRIMARY KEY NOT NULL,
    chat_id TEXT NOT NULL,
    server_seq INTEGER NOT NULL CHECK(server_seq > 0),
    payload BLOB NOT NULL,
    acked INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    acked_at INTEGER
);
-- CREATE / EDIT / REVOKE events deliberately reuse the same chat/server sequence. event_id is
-- the replay-idempotency key; this index only accelerates chat-scoped diagnostics and cleanup.
CREATE INDEX IF NOT EXISTS idx_bot_inbox_message ON bot_message_inbox(chat_id, server_seq);

-- 查询
selectAllUsers:
SELECT * FROM user;

selectUserByUid:
SELECT * FROM user WHERE uid = ?;

upsertUser:
INSERT OR REPLACE INTO user(uid, username, name, avatar, phone, sex, role, status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectAllContacts:
SELECT * FROM contact WHERE status = 1;

upsertContact:
INSERT OR REPLACE INTO contact(uid, friend_uid, remark, status)
VALUES (?, ?, ?, ?);

deleteContact:
DELETE FROM contact WHERE friend_uid = ?;

deleteAllContacts:
DELETE FROM contact;

selectChatById:
SELECT * FROM chat WHERE chat_id = ?;

selectAllChats:
SELECT * FROM chat;

upsertChat:
INSERT OR REPLACE INTO chat(chat_id, chat_type, name, avatar, creator, member_count, max_seq, notice, muted_all)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteChat:
DELETE FROM chat WHERE chat_id = ?;

selectMembersByChat:
SELECT * FROM member WHERE chat_id = ?;

upsertMember:
INSERT OR REPLACE INTO member(chat_id, uid, role, nickname, joined_at)
VALUES (?, ?, ?, ?, ?);

removeMember:
DELETE FROM member WHERE chat_id = ? AND uid = ?;

deleteMembersByChat:
DELETE FROM member WHERE chat_id = ?;

-- Initial resident window: optimistic facts are selected first under an explicit memory cap.
selectOptimisticMessagesByChat:
SELECT * FROM message
WHERE chat_id = ? AND server_seq = 0
ORDER BY timestamp DESC, client_msg_id ASC
LIMIT ?;

selectLatestAuthoritativeMessagesByChat:
SELECT * FROM message
WHERE chat_id = ? AND server_seq > 0
ORDER BY server_seq DESC
LIMIT ?;

selectMessageById:
SELECT * FROM message WHERE chat_id = ? AND client_msg_id = ?;

-- 向上翻页：加载某个 seq 之前的更老消息（利用 idx_message_chat_seq 索引）
-- server_seq > 0 排除正在发送的消息（serverSeq=0 表示尚未服务端确认）
selectMessagesByChatBefore:
SELECT * FROM message
WHERE chat_id = ? AND server_seq < ? AND server_seq > 0
ORDER BY server_seq DESC
LIMIT ?;

-- 查当前会话的媒体消息（图片+视频），用于全屏滑动浏览器
selectMediaMessagesByChat:
SELECT * FROM message
WHERE chat_id = ? AND (message_type = 2 OR message_type = 4)
ORDER BY server_seq ASC;

-- 统计某 chat 的消息总数（用于 hasMore 判断和内存治理阈值）
countMessagesByChat:
SELECT COUNT(*) FROM message WHERE chat_id = ?;

insertMessage:
INSERT OR REPLACE INTO message(chat_id, client_msg_id, server_seq, sender_uid, message_type, timestamp, flags, body, send_status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

enqueueOutgoingMessage:
INSERT OR IGNORE INTO outgoing_message(
    client_msg_id, chat_id, payload, request_fingerprint, state, attempt_count, last_error,
    terminal_code, server_seq, next_attempt_at, created_at, updated_at, completed_at
) VALUES (?, ?, ?, ?, 0, 0, NULL, NULL, NULL, 0, ?, ?, NULL);

selectOutgoingMessageById:
SELECT * FROM outgoing_message WHERE chat_id = ? AND client_msg_id = ?;

selectOutgoingMessageByOrdinal:
SELECT * FROM outgoing_message WHERE local_ordinal = ?;

selectAllOutgoingMessages:
SELECT * FROM outgoing_message ORDER BY local_ordinal ASC;

selectMaxOutgoingCompletedAt:
SELECT MAX(completed_at) AS max_completed_at FROM outgoing_message;

selectOrphanedLocalMessages:
SELECT * FROM message
WHERE server_seq = 0
  AND (send_status = 1 OR send_status = 3 OR send_status = 4)
  AND NOT EXISTS (
      SELECT 1 FROM outgoing_message
      WHERE outgoing_message.chat_id = message.chat_id
        AND outgoing_message.client_msg_id = message.client_msg_id
  );

failOrphanedLocalMessages:
UPDATE message
SET send_status = 2
WHERE server_seq = 0
  AND (send_status = 1 OR send_status = 3 OR send_status = 4)
  AND NOT EXISTS (
      SELECT 1 FROM outgoing_message
      WHERE outgoing_message.chat_id = message.chat_id
        AND outgoing_message.client_msg_id = message.client_msg_id
  );

selectNextActiveOutgoingMessage:
SELECT * FROM outgoing_message
WHERE state = 0 OR state = 2
ORDER BY local_ordinal ASC
LIMIT 1;

recoverInFlightOutgoingMessages:
UPDATE outgoing_message
SET state = 0, last_error = 'interrupted before durable response', next_attempt_at = 0,
    updated_at = ?
WHERE state = 1;

markOutgoingMessageInFlight:
UPDATE outgoing_message
SET state = 1, attempt_count = attempt_count + 1, last_error = NULL, updated_at = ?
WHERE local_ordinal = ? AND (state = 0 OR state = 2);

markOutgoingMessageRetry:
UPDATE outgoing_message
SET state = 2, last_error = ?, terminal_code = NULL, next_attempt_at = ?, updated_at = ?
WHERE local_ordinal = ? AND state = 1;

markOutgoingMessageTerminalFailed:
UPDATE outgoing_message
SET state = 3, last_error = ?, terminal_code = ?, next_attempt_at = 0, updated_at = ?,
    completed_at = ?
WHERE local_ordinal = ? AND state = 1;

markOutgoingMessageSucceeded:
UPDATE outgoing_message
SET state = 4, last_error = NULL, terminal_code = NULL, server_seq = ?, next_attempt_at = 0,
    updated_at = ?, completed_at = ?
WHERE local_ordinal = ? AND state = 1;

promoteOutgoingMessageSucceededFromProjection:
UPDATE outgoing_message
SET state = 4, last_error = NULL, terminal_code = NULL, server_seq = ?, next_attempt_at = 0,
    updated_at = ?, completed_at = ?
WHERE local_ordinal = ? AND state != 4;

pruneOutgoingSuccessReceipts:
DELETE FROM outgoing_message
WHERE state = 4
  AND local_ordinal NOT IN (
      SELECT local_ordinal FROM outgoing_message
      WHERE state = 4
      ORDER BY completed_at DESC, local_ordinal DESC
      LIMIT :retained
  );

cancelActiveOutgoingMessages:
UPDATE outgoing_message
SET state = 3, last_error = ?, terminal_code = 499, next_attempt_at = 0, updated_at = ?,
    completed_at = ?
WHERE state = 0 OR state = 1 OR state = 2;

deleteOutgoingMessage:
DELETE FROM outgoing_message WHERE local_ordinal = ?;

deleteOutgoingMessagesByChat:
DELETE FROM outgoing_message WHERE chat_id = ?;

deleteAllOutgoingMessages:
DELETE FROM outgoing_message;

updateMessageSeqStatus:
UPDATE message SET server_seq = ?, send_status = 0
WHERE chat_id = ? AND client_msg_id = ? AND server_seq = 0;

updateMessageSendStatus:
UPDATE message SET send_status = ?
WHERE chat_id = ? AND client_msg_id = ? AND server_seq = 0;

markAuthoritativeMessageSent:
UPDATE message SET send_status = 0
WHERE chat_id = ? AND client_msg_id = ? AND server_seq > 0;

deleteMessage:
DELETE FROM message WHERE chat_id = ? AND client_msg_id = ?;

deleteMessagesByChat:
DELETE FROM message WHERE chat_id = ?;

selectAllConversations:
SELECT * FROM conversation ORDER BY is_pinned DESC, last_msg_timestamp DESC;

upsertConversation:
INSERT OR REPLACE INTO conversation(chat_id, chat_type, chat_name, chat_avatar, last_seq, read_seq, peer_read_seq, unread_count, is_pinned, is_muted, draft, last_msg_timestamp)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteConversation:
DELETE FROM conversation WHERE chat_id = ?;

markConversationRead:
UPDATE conversation
SET unread_count = MAX(0, last_seq - MAX(read_seq, :readSeq)),
    read_seq = MAX(read_seq, :readSeq)
WHERE chat_id = :chatId;

setConversationDraft:
UPDATE conversation SET draft = ? WHERE chat_id = ?;

selectAllConversationDraftOutbox:
SELECT * FROM conversation_draft_outbox;

upsertConversationDraftOutbox:
INSERT OR REPLACE INTO conversation_draft_outbox(chat_id, draft, generation, state)
VALUES (?, ?, ?, ?);

markConversationDraftOutboxAcked:
UPDATE conversation_draft_outbox SET state = 1
WHERE chat_id = ? AND generation = ? AND state = 0;

deleteConversationDraftOutbox:
DELETE FROM conversation_draft_outbox WHERE chat_id = ?;

updatePeerReadSeq:
UPDATE conversation SET peer_read_seq = ? WHERE chat_id = ?;

getSyncCursor:
SELECT value FROM sync_cursor WHERE key = ?;

ensureSyncCursor:
INSERT OR IGNORE INTO sync_cursor(key, value) VALUES (?, 0);

advanceSyncCursor:
UPDATE sync_cursor
SET value = CASE WHEN :value > value THEN :value ELSE value END
WHERE key = :key;

enqueueBotMessage:
INSERT OR IGNORE INTO bot_message_inbox(
    event_id, chat_id, server_seq, payload, acked, created_at, acked_at
) VALUES (?, ?, ?, ?, 0, ?, NULL);

peekBotMessage:
SELECT event_id, payload FROM bot_message_inbox
WHERE acked = 0
ORDER BY event_id ASC
LIMIT 1;

ackBotMessage:
UPDATE bot_message_inbox SET acked = 1, acked_at = ?
WHERE event_id = ? AND acked = 0;

selectBotMessageDeliveries:
SELECT event_id, payload FROM bot_message_inbox
WHERE event_id > :afterEventId
  AND (:chatId IS NULL OR chat_id = :chatId)
ORDER BY event_id ASC
LIMIT :limit;

selectMaxBotMessageEventId:
SELECT COALESCE(MAX(event_id), 0) AS max_event_id FROM bot_message_inbox;

deleteBotMessagesByChat:
DELETE FROM bot_message_inbox WHERE chat_id = ?;

deleteAllUsers:
DELETE FROM user;

deleteAllChats:
DELETE FROM chat;

deleteAllMembers:
DELETE FROM member;

deleteAllMessages:
DELETE FROM message;

deleteAllConversations:
DELETE FROM conversation;

deleteAllConversationDraftOutbox:
DELETE FROM conversation_draft_outbox;

deleteAllSyncCursors:
DELETE FROM sync_cursor;

deleteAllBotMessages:
DELETE FROM bot_message_inbox;
