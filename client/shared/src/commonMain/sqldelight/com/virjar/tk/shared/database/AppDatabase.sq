WHERE NOT EXISTS (
    SELECT 1 FROM document_space WHERE document_space.space_id = document_body.space_id
);

deleteDocumentHomeForUnknownSpaces:
DELETE FROM document_home_item
WHERE NOT EXISTS (
    SELECT 1 FROM document_space WHERE document_space.space_id = document_home_item.space_id
);

deleteDocumentNodesForUnknownSpaces:
DELETE FROM document_node
WHERE NOT EXISTS (
    SELECT 1 FROM document_space WHERE document_space.space_id = document_node.space_id
);

deleteDocumentBranchesForUnknownSpaces:
DELETE FROM document_branch
WHERE NOT EXISTS (
    SELECT 1 FROM document_space WHERE document_space.space_id = document_branch.space_id
);

deleteAllDocumentBodyAncestors:
DELETE FROM document_body_ancestor;

deleteAllDocumentBodies:
DELETE FROM document_body;

deleteAllDocumentHome:
DELETE FROM document_home_item;

deleteAllDocumentNodes:
DELETE FROM document_node;

deleteAllDocumentBranches:
DELETE FROM document_branch;

deleteAllDocumentProjectionMarkers:
DELETE FROM document_projection_marker;

-- Initial resident window: optimistic facts are selected first under an explicit memory cap.
selectOptimisticMessagesByChat:
SELECT * FROM message
WHERE chat_id = ? AND server_seq = 0
ORDER BY timestamp DESC, client_msg_id ASC
LIMIT ?;

selectLatestAuthoritativeMessagesByChat:
SELECT * FROM message
WHERE chat_id = ? AND server_seq > 0
ORDER BY server_seq DESC
LIMIT ?;

-- Retention counts only re-fetchable server projections. A non-success outgoing row or stable
-- local failure code is a recovery fact and pins its projection regardless of the normal budget.
selectAuthoritativeMessageRetentionCandidates:
SELECT message.chat_id
FROM message
WHERE message.server_seq > 0
  AND message.outgoing_failure_code IS NULL
  AND NOT EXISTS (
      SELECT 1 FROM outgoing_message
      WHERE outgoing_message.chat_id = message.chat_id
        AND outgoing_message.client_msg_id = message.client_msg_id
        AND outgoing_message.sender_uid = message.sender_uid
        AND outgoing_message.state != 4
  )
GROUP BY message.chat_id
HAVING COUNT(*) > :retainedCount
    OR SUM(
        64 + length(CAST(message.chat_id AS BLOB)) +
        length(CAST(message.client_msg_id AS BLOB)) +
        length(CAST(message.sender_uid AS BLOB)) + COALESCE(length(message.body), 0)
    ) > :retainedBytes
ORDER BY message.chat_id ASC
LIMIT :limit;

-- Only count + 1 rows cross the SQL boundary. The fixed 64 bytes estimate the scalar columns and
-- row framing; text is measured as its stored UTF-8 blob and body is already its encoded blob.
selectAuthoritativeMessageRetentionMetadata:
SELECT message.client_msg_id,
       message.server_seq,
       64 + length(CAST(message.chat_id AS BLOB)) +
           length(CAST(message.client_msg_id AS BLOB)) +
           length(CAST(message.sender_uid AS BLOB)) +
           COALESCE(length(message.body), 0) AS estimated_bytes
FROM message
WHERE message.chat_id = :chatId
  AND message.server_seq > 0
  AND message.outgoing_failure_code IS NULL
  AND NOT EXISTS (
      SELECT 1 FROM outgoing_message
      WHERE outgoing_message.chat_id = message.chat_id
        AND outgoing_message.client_msg_id = message.client_msg_id
        AND outgoing_message.sender_uid = message.sender_uid
        AND outgoing_message.state != 4
  )
ORDER BY message.server_seq DESC, message.client_msg_id DESC
LIMIT :limit;

deleteAllRetainableAuthoritativeMessagesBatch:
DELETE FROM message
WHERE message.chat_id = :chatId
  AND message.client_msg_id IN (
      SELECT candidate.client_msg_id
      FROM message AS candidate
      WHERE candidate.chat_id = :chatId
        AND candidate.server_seq > 0
        AND candidate.outgoing_failure_code IS NULL
        AND NOT EXISTS (
            SELECT 1 FROM outgoing_message
            WHERE outgoing_message.chat_id = candidate.chat_id
              AND outgoing_message.client_msg_id = candidate.client_msg_id
              AND outgoing_message.sender_uid = candidate.sender_uid
              AND outgoing_message.state != 4
        )
      ORDER BY candidate.server_seq ASC, candidate.client_msg_id ASC
      LIMIT :limit
  );

deleteOlderRetainableAuthoritativeMessagesBatch:
DELETE FROM message
WHERE message.chat_id = :chatId
  AND message.client_msg_id IN (
      SELECT candidate.client_msg_id
      FROM message AS candidate
      WHERE candidate.chat_id = :chatId
        AND candidate.server_seq > 0
        AND candidate.outgoing_failure_code IS NULL
        AND (
            candidate.server_seq < :oldestRetainedServerSeq
            OR (
                candidate.server_seq = :oldestRetainedServerSeq
                AND candidate.client_msg_id < :oldestRetainedClientMsgId
            )
        )
        AND NOT EXISTS (
            SELECT 1 FROM outgoing_message
            WHERE outgoing_message.chat_id = candidate.chat_id
              AND outgoing_message.client_msg_id = candidate.client_msg_id
              AND outgoing_message.sender_uid = candidate.sender_uid
              AND outgoing_message.state != 4
        )
      ORDER BY candidate.server_seq ASC, candidate.client_msg_id ASC
      LIMIT :limit
  );

selectMessageById:
SELECT * FROM message WHERE chat_id = ? AND client_msg_id = ?;

-- 向上翻页：加载某个 seq 之前的更老消息（利用 idx_message_chat_seq 索引）
-- server_seq > 0 排除正在发送的消息（serverSeq=0 表示尚未服务端确认）
selectMessagesByChatBefore:
SELECT * FROM message
WHERE chat_id = ? AND server_seq < ? AND server_seq > 0
ORDER BY server_seq DESC
LIMIT ?;

insertMessage:
INSERT OR REPLACE INTO message(chat_id, client_msg_id, server_seq, sender_uid, message_type, timestamp, flags, body, send_status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertMessageIfAbsent:
INSERT OR IGNORE INTO message(chat_id, client_msg_id, server_seq, sender_uid, message_type, timestamp, flags, body, send_status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

enqueueOutgoingMessage:
INSERT OR IGNORE INTO outgoing_message(
    client_msg_id, chat_id, sender_uid, payload, request_fingerprint, state, attempt_count, failure_code, last_error,
    terminal_code, server_seq, next_attempt_at, created_at, updated_at, completed_at
) VALUES (?, ?, ?, ?, ?, 0, 0, NULL, NULL, NULL, NULL, 0, ?, ?, NULL);

insertFreshOutgoingReplacement:
INSERT INTO outgoing_message(
    client_msg_id, chat_id, sender_uid, payload, request_fingerprint, state, attempt_count,
    failure_code, last_error, terminal_code, server_seq, next_attempt_at, created_at, updated_at,
    completed_at
) VALUES (?, ?, ?, ?, ?, 0, 0, NULL, NULL, NULL, NULL, 0, ?, ?, NULL);

selectPendingGroupCreation:
