WHERE singleton_id = 1 AND operation_id = ?;

selectOutgoingMessageById:
SELECT * FROM outgoing_message WHERE chat_id = ? AND client_msg_id = ?;

selectOutgoingMessageByOrdinal:
SELECT * FROM outgoing_message WHERE local_ordinal = ?;

selectAllOutgoingMessages:
SELECT * FROM outgoing_message ORDER BY local_ordinal ASC;

selectOutgoingQueueSnapshot:
SELECT
    COALESCE(SUM(CASE WHEN state = 0 OR state = 1 THEN 1 ELSE 0 END), 0)
        AS pending_or_inflight_count,
    COALESCE(SUM(CASE WHEN state = 2 THEN 1 ELSE 0 END), 0) AS retry_wait_count,
    COALESCE(SUM(CASE WHEN state = 3 THEN 1 ELSE 0 END), 0) AS terminal_failed_count,
    MIN(CASE WHEN state = 0 OR state = 1 OR state = 2 THEN created_at END)
        AS oldest_active_created_at,
    COALESCE(MAX(CASE WHEN state != 4 THEN attempt_count ELSE 0 END), 0) AS max_attempt_count
FROM outgoing_message;

countActiveOutgoingMessages:
SELECT COUNT(*) FROM outgoing_message WHERE state = 0 OR state = 1 OR state = 2;

sumActiveOutgoingStorageBytes:
SELECT COALESCE(SUM(length(payload) + COALESCE(length(request_fingerprint), 0)), 0)
FROM outgoing_message
WHERE state = 0 OR state = 1 OR state = 2;

selectActiveOutgoingMessages:
SELECT * FROM outgoing_message
WHERE state = 0 OR state = 1 OR state = 2
ORDER BY local_ordinal ASC;

selectTerminalOutgoingStorageNewestFirst:
SELECT local_ordinal,
       length(payload) + COALESCE(length(request_fingerprint), 0) AS stored_bytes
FROM outgoing_message
WHERE state = 3 OR state = 4
ORDER BY completed_at DESC, local_ordinal DESC;

selectMaxOutgoingCompletedAt:
SELECT MAX(completed_at) AS max_completed_at FROM outgoing_message;

failOrphanedLocalMessages:
UPDATE message
SET send_status = 2
WHERE server_seq = 0
  AND (send_status = 1 OR send_status = 3 OR send_status = 4)
  AND NOT EXISTS (
      SELECT 1 FROM outgoing_message
      WHERE outgoing_message.chat_id = message.chat_id
        AND outgoing_message.client_msg_id = message.client_msg_id
  );

selectNextActiveOutgoingMessage:
SELECT * FROM outgoing_message
WHERE state = 0 OR state = 2
ORDER BY local_ordinal ASC
LIMIT 1;

recoverInFlightOutgoingMessages:
UPDATE outgoing_message
SET state = 0, failure_code = :failureCode, last_error = :diagnostic, next_attempt_at = 0,
    updated_at = :updatedAt
WHERE state = 1;

markAuthoritativeMessagesSentForOutgoing:
UPDATE message
SET send_status = 0, outgoing_failure_code = NULL
WHERE server_seq > 0
  AND send_status != 0
  AND EXISTS (
      SELECT 1 FROM outgoing_message
      WHERE outgoing_message.chat_id = message.chat_id
        AND outgoing_message.client_msg_id = message.client_msg_id
        AND outgoing_message.sender_uid = message.sender_uid
  );

countPromotableOutgoingMessages:
SELECT COUNT(*) FROM outgoing_message
WHERE state != 4
  AND EXISTS (
      SELECT 1 FROM message
      WHERE message.chat_id = outgoing_message.chat_id
        AND message.client_msg_id = outgoing_message.client_msg_id
        AND message.sender_uid = outgoing_message.sender_uid
        AND message.server_seq > 0
  );

promoteOutgoingMessagesFromAuthoritativeProjection:
UPDATE outgoing_message
SET state = 4,
    failure_code = NULL,
    last_error = NULL,
    terminal_code = NULL,
    server_seq = (
        SELECT message.server_seq FROM message
        WHERE message.chat_id = outgoing_message.chat_id
          AND message.client_msg_id = outgoing_message.client_msg_id
          AND message.sender_uid = outgoing_message.sender_uid
          AND message.server_seq > 0
    ),
    next_attempt_at = 0,
    updated_at = :updatedAt,
    completed_at = :completedAt
WHERE state != 4
  AND EXISTS (
      SELECT 1 FROM message
      WHERE message.chat_id = outgoing_message.chat_id
        AND message.client_msg_id = outgoing_message.client_msg_id
        AND message.sender_uid = outgoing_message.sender_uid
        AND message.server_seq > 0
  );

reconcileOutgoingProjectionStatuses:
UPDATE message
SET send_status = (
    SELECT CASE outgoing_message.state
        WHEN 0 THEN 4
        WHEN 1 THEN 1
        WHEN 2 THEN 4
        WHEN 3 THEN 2
    END
    FROM outgoing_message
    WHERE outgoing_message.chat_id = message.chat_id
      AND outgoing_message.client_msg_id = message.client_msg_id
      AND outgoing_message.sender_uid = message.sender_uid
      AND outgoing_message.state != 4
),
outgoing_failure_code = (
    SELECT CASE outgoing_message.state
        WHEN 3 THEN outgoing_message.failure_code
        ELSE NULL
    END
    FROM outgoing_message
    WHERE outgoing_message.chat_id = message.chat_id
      AND outgoing_message.client_msg_id = message.client_msg_id
      AND outgoing_message.sender_uid = message.sender_uid
      AND outgoing_message.state != 4
)
WHERE server_seq = 0
  AND EXISTS (
      SELECT 1 FROM outgoing_message
      WHERE outgoing_message.chat_id = message.chat_id
        AND outgoing_message.client_msg_id = message.client_msg_id
        AND outgoing_message.sender_uid = message.sender_uid
        AND outgoing_message.state != 4
  );

selectOutgoingMessagesMissingProjection:
SELECT * FROM outgoing_message
WHERE state != 4
  AND NOT EXISTS (
      SELECT 1 FROM message
      WHERE message.chat_id = outgoing_message.chat_id
        AND message.client_msg_id = outgoing_message.client_msg_id
  )
ORDER BY local_ordinal ASC
LIMIT :limit;

markOutgoingMessageInFlight:
UPDATE outgoing_message
SET state = 1, attempt_count = attempt_count + 1, failure_code = NULL, last_error = NULL,
    updated_at = ?
WHERE local_ordinal = ? AND (state = 0 OR state = 2);

markOutgoingMessageRetry:
UPDATE outgoing_message
SET state = 2, failure_code = ?, last_error = ?, terminal_code = NULL, next_attempt_at = ?,
    updated_at = ?
WHERE local_ordinal = ? AND state = 1;

markOutgoingMessageTerminalFailed:
UPDATE outgoing_message
SET state = 3, failure_code = ?, last_error = ?, terminal_code = ?, next_attempt_at = 0,
    updated_at = ?,
    completed_at = ?
WHERE local_ordinal = ? AND state = 1;

markOutgoingMessageSucceeded:
UPDATE outgoing_message
SET state = 4, failure_code = NULL, last_error = NULL, terminal_code = NULL, server_seq = ?, next_attempt_at = 0,
    updated_at = ?, completed_at = ?
WHERE local_ordinal = ? AND state = 1;

promoteOutgoingMessageSucceededFromProjection:
UPDATE outgoing_message
SET state = 4, failure_code = NULL, last_error = NULL, terminal_code = NULL, server_seq = ?, next_attempt_at = 0,
    updated_at = ?, completed_at = ?
WHERE local_ordinal = ? AND state != 4;

cancelActiveOutgoingMessages:
UPDATE outgoing_message
SET state = 3, failure_code = ?, last_error = ?, terminal_code = 499, next_attempt_at = 0,
    updated_at = ?,
    completed_at = ?
WHERE state = 0 OR state = 1 OR state = 2;

deleteOutgoingMessage:
DELETE FROM outgoing_message WHERE local_ordinal = ?;

deleteOutgoingMessagesByChat:
DELETE FROM outgoing_message WHERE chat_id = ?;

updateMessageSeqStatus:
UPDATE message SET server_seq = ?, send_status = 0, outgoing_failure_code = NULL
WHERE chat_id = ? AND client_msg_id = ? AND server_seq = 0;

updateMessageSendStatus:
UPDATE message SET send_status = ?, outgoing_failure_code = NULL
WHERE chat_id = ? AND client_msg_id = ? AND server_seq = 0;

updateMessageTerminalFailure:
UPDATE message SET send_status = 2, outgoing_failure_code = ?
WHERE chat_id = ? AND client_msg_id = ? AND server_seq = 0;

markAuthoritativeMessageSent:
UPDATE message SET send_status = 0, outgoing_failure_code = NULL
WHERE chat_id = ? AND client_msg_id = ? AND server_seq > 0;

deleteMessage:
DELETE FROM message WHERE chat_id = ? AND client_msg_id = ?;

deleteFailedOptimisticMessage:
DELETE FROM message
WHERE chat_id = ? AND client_msg_id = ? AND sender_uid = ? AND server_seq = 0 AND send_status = 2;

deleteMessagesByChat:
DELETE FROM message WHERE chat_id = ?;

selectAllConversations:
SELECT * FROM conversation ORDER BY is_pinned DESC, last_msg_timestamp DESC;

upsertConversation:
INSERT OR REPLACE INTO conversation(
    chat_id, chat_type, peer_uid, peer_revision, chat_name,
    chat_avatar_path, chat_avatar_name, chat_avatar_content_type, chat_avatar_size,
    last_message, last_message_type, last_msg_timestamp, last_seq, read_seq, peer_read_seq,
    unread_count, is_pinned, is_muted, draft
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteConversation:
DELETE FROM conversation WHERE chat_id = ?;

markConversationRead:
UPDATE conversation
SET unread_count = MAX(0, last_seq - MAX(read_seq, :readSeq)),
    read_seq = MAX(read_seq, :readSeq)
WHERE chat_id = :chatId;

setConversationDraft:
UPDATE conversation SET draft = ? WHERE chat_id = ?;

selectAllConversationDraftOutbox:
SELECT * FROM conversation_draft_outbox;

upsertConversationDraftOutbox:
INSERT OR REPLACE INTO conversation_draft_outbox(chat_id, draft, generation, state)
VALUES (?, ?, ?, ?);

markConversationDraftOutboxAcked:
UPDATE conversation_draft_outbox SET state = 1
WHERE chat_id = ? AND generation = ? AND state = 0;

deleteConversationDraftOutbox:
DELETE FROM conversation_draft_outbox WHERE chat_id = ?;

selectAllConversationReadOutbox:
SELECT * FROM conversation_read_outbox ORDER BY chat_id;

ensureConversationReadOutbox:
INSERT OR IGNORE INTO conversation_read_outbox(chat_id, read_seq)
VALUES (:chatId, :readSeq);

advanceConversationReadOutbox:
UPDATE conversation_read_outbox
SET read_seq = MAX(read_seq, :readSeq)
WHERE chat_id = :chatId;

ackConversationReadOutbox:
DELETE FROM conversation_read_outbox
WHERE chat_id = :chatId AND read_seq <= :readSeq;

deleteConversationReadOutbox:
DELETE FROM conversation_read_outbox WHERE chat_id = ?;

updatePeerReadSeq:
UPDATE conversation SET peer_read_seq = ? WHERE chat_id = ?;

selectSyncState:
SELECT dataset_id, cursor FROM sync_state WHERE singleton_id = 1;

bindSyncDataset:
INSERT OR IGNORE INTO sync_state(singleton_id, dataset_id, cursor) VALUES (1, :datasetId, 0);

advanceSyncCursor:
UPDATE sync_state
SET cursor = CASE WHEN :eventId > cursor THEN :eventId ELSE cursor END
WHERE singleton_id = 1 AND dataset_id = :expectedDatasetId;

-- A checkpoint replaces the same dataset projection at one exact request cursor. The caller
-- verifies the affected authority tuple in the surrounding cross-projection transaction.
applySyncCheckpointCursor:
UPDATE sync_state
SET cursor = :baseEventId
WHERE singleton_id = 1
  AND dataset_id = :expectedDatasetId
  AND cursor = :expectedCursor;

resetSyncState:
INSERT OR REPLACE INTO sync_state(singleton_id, dataset_id, cursor)
VALUES (1, :datasetId, 0);

ensureBotInboxMetadata:
INSERT OR IGNORE INTO bot_inbox_metadata(singleton_id, retained_floor_event_id) VALUES (1, 0);

selectBotInboxRetainedFloor:
SELECT retained_floor_event_id FROM bot_inbox_metadata WHERE singleton_id = 1;

advanceBotInboxRetainedFloor:
UPDATE bot_inbox_metadata
SET retained_floor_event_id = MAX(retained_floor_event_id, :eventId)
WHERE singleton_id = 1;

resetBotInboxMetadata:
INSERT OR REPLACE INTO bot_inbox_metadata(singleton_id, retained_floor_event_id) VALUES (1, 0);

enqueueBotMessage:
INSERT OR IGNORE INTO bot_message_inbox(
    event_id, chat_id, server_seq, payload, acked, created_at, acked_at
) VALUES (?, ?, ?, ?, 0, ?, NULL);

peekBotMessage:
SELECT event_id, payload FROM bot_message_inbox
WHERE acked = 0
ORDER BY event_id ASC
LIMIT 1;

ackBotMessage:
UPDATE bot_message_inbox SET acked = 1, acked_at = ?
WHERE event_id = ? AND acked = 0;

selectAckedBotMessageStorageNewestFirst:
SELECT event_id, length(payload) AS payload_bytes
FROM bot_message_inbox
WHERE acked = 1
ORDER BY event_id DESC
LIMIT :limit;

deleteAckedBotMessagesThrough:
DELETE FROM bot_message_inbox
WHERE acked = 1 AND event_id <= :eventId;

selectOldestPendingBotMessageEventId:
SELECT COALESCE(MIN(event_id), 0) AS min_event_id
FROM bot_message_inbox
WHERE acked = 0;

selectNewestAckedBotMessageEventIdThrough:
SELECT COALESCE(MAX(event_id), 0) AS max_event_id
FROM bot_message_inbox
WHERE acked = 1 AND event_id <= :eventId;

selectBotMessageDeliveries:
SELECT event_id, payload FROM bot_message_inbox
WHERE event_id > :afterEventId
  AND (:chatId IS NULL OR chat_id = :chatId)
ORDER BY event_id ASC
LIMIT :limit;

selectMaxBotMessageEventId:
SELECT COALESCE(MAX(event_id), 0) AS max_event_id FROM bot_message_inbox;

deleteBotMessagesByChat:
DELETE FROM bot_message_inbox WHERE chat_id = ?;

deleteAllUsers:
DELETE FROM user;

deleteAllChats:
DELETE FROM chat;

deleteAllMembers:
DELETE FROM member;

-- Server projection reset must retain the only recovery authority left after terminal receipt GC.
-- Keep qualifying orphan rows in place so reset does not materialize an unbounded set of message
-- payloads in Kotlin. Any same-key outbox row is deleted here and rebuilt from its bounded canonical
-- payload afterwards; NULL/authoritative/non-failed/blank identities fail closed and are removed.
deleteServerProjectionMessagesPreservingOrphanFailures:
DELETE FROM message
WHERE COALESCE(server_seq, -1) != 0
   OR COALESCE(send_status, -1) != 2
   OR length(chat_id) = 0
   OR length(client_msg_id) = 0
   OR length(sender_uid) = 0
   OR EXISTS (
       SELECT 1 FROM outgoing_message
       WHERE outgoing_message.chat_id = message.chat_id
         AND outgoing_message.client_msg_id = message.client_msg_id
   );

deleteAllConversations:
DELETE FROM conversation;

deleteAllBotMessages:
DELETE FROM bot_message_inbox;

insertMessageReaction:
INSERT OR IGNORE INTO message_reaction(chat_id, server_seq, emoji, uid)
VALUES (?, ?, ?, ?);

deleteMessageReaction:
DELETE FROM message_reaction
WHERE chat_id = ? AND server_seq = ? AND emoji = ? AND uid = ?;

deleteMessageReactionsForSeq:
DELETE FROM message_reaction WHERE chat_id = ? AND server_seq = ?;

deleteMessageReactionsInRange:
DELETE FROM message_reaction WHERE chat_id = ? AND server_seq >= ? AND server_seq <= ?;

-- 群共享文件的行级本地投影（CONTENT-01）。行来自 GROUP_FILE_CHANGED delta 与目录页快照；
-- deleted=1 是墓穴行，阻挡乱序迟到 UPSERT 复活已删条目，随目录快照与容量上限回收。
CREATE TABLE IF NOT EXISTS group_file_entry (
    chat_id TEXT NOT NULL,
    entry_id TEXT NOT NULL,
    parent_id TEXT NOT NULL,
    kind INTEGER NOT NULL CHECK(kind IN (1, 2)),
    name TEXT NOT NULL,
    attachment_path TEXT,
    attachment_name TEXT,
    attachment_content_type TEXT,
    attachment_size INTEGER CHECK(attachment_size IS NULL OR attachment_size >= 0),
    revision INTEGER NOT NULL CHECK(revision > 0),
    content_version INTEGER NOT NULL CHECK(content_version >= 0),
    created_by TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_by TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0 CHECK(deleted IN (0, 1)),
    PRIMARY KEY (chat_id, entry_id)
);
CREATE INDEX IF NOT EXISTS idx_group_file_entry_parent
ON group_file_entry(chat_id, parent_id, deleted);

upsertGroupFileEntry:
INSERT OR REPLACE INTO group_file_entry(
    chat_id, entry_id, parent_id, kind, name, attachment_path, attachment_name,
    attachment_content_type, attachment_size, revision, content_version,
    created_by, created_at, updated_by, updated_at, deleted
) VALUES (
    ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0
);

selectGroupFileEntry:
SELECT * FROM group_file_entry WHERE chat_id = ? AND entry_id = ?;

selectActiveGroupFileEntries:
SELECT * FROM group_file_entry
WHERE chat_id = ? AND parent_id = ? AND deleted = 0
ORDER BY kind ASC, name ASC;

markGroupFileEntryDeleted:
UPDATE group_file_entry
SET deleted = 1, revision = ?, updated_by = ?, updated_at = ?
WHERE chat_id = ? AND entry_id = ? AND deleted = 0 AND revision <= ?;

insertGroupFileTombstone:
INSERT OR IGNORE INTO group_file_entry(
    chat_id, entry_id, parent_id, kind, name, revision, content_version,
    created_by, created_at, updated_by, updated_at, deleted
) VALUES (?, ?, '', 0, '', ?, 0, ?, ?, ?, ?, 1);

deleteGroupFileDirectory:
DELETE FROM group_file_entry WHERE chat_id = ? AND parent_id = ?;

countGroupFileRows:
SELECT COUNT(*) FROM group_file_entry WHERE chat_id = ?;

pruneOldestGroupFileRows:
DELETE FROM group_file_entry WHERE chat_id = ? AND deleted = 0 AND entry_id IN (
    SELECT entry_id FROM group_file_entry WHERE chat_id = ? AND deleted = 0
    ORDER BY updated_at ASC, entry_id ASC LIMIT ?
);

deleteAllGroupFileEntriesForChat:
DELETE FROM group_file_entry WHERE chat_id = ?;

deleteAllGroupFileEntries:
DELETE FROM group_file_entry;

deleteAllMessageReactionsForChat:
DELETE FROM message_reaction WHERE chat_id = ?;

deleteAllMessageReactions:
DELETE FROM message_reaction;

-- 只回收其消息行已被保留策略删除的回应；批删未完成的窗口由下一次 prune 收敛。
deleteOrphanMessageReactions:
DELETE FROM message_reaction
WHERE chat_id = ?
  AND server_seq NOT IN (
      SELECT server_seq FROM message WHERE chat_id = message_reaction.chat_id AND server_seq > 0
  );

selectMessageReactionsForChat:
SELECT chat_id, server_seq, emoji, uid FROM message_reaction
WHERE chat_id = ?
ORDER BY server_seq, emoji, uid;
