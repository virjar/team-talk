-- 发布前阶段本地库按 schema epoch 整库重建，不维护就地迁移。
-- 用户
CREATE TABLE IF NOT EXISTS user (
    uid TEXT PRIMARY KEY NOT NULL,
    username TEXT NOT NULL,
    name TEXT NOT NULL,
    avatar_path TEXT,
    avatar_name TEXT,
    avatar_content_type TEXT,
    avatar_size INTEGER,
    phone TEXT,
    sex INTEGER DEFAULT 0,
    role INTEGER DEFAULT 0,
    status INTEGER DEFAULT 1,
    revision INTEGER NOT NULL DEFAULT 1 CHECK(revision > 0),
    CHECK(
        (avatar_path IS NULL AND avatar_name IS NULL AND avatar_content_type IS NULL AND avatar_size IS NULL) OR
        (avatar_path IS NOT NULL AND avatar_name IS NOT NULL AND avatar_content_type IS NOT NULL AND avatar_size >= 0)
    )
);

-- 联系人
CREATE TABLE IF NOT EXISTS contact (
    uid TEXT NOT NULL,
    friend_uid TEXT NOT NULL,
    remark TEXT,
    status INTEGER DEFAULT 1,
    PRIMARY KEY (uid, friend_uid)
);

-- 聊天
CREATE TABLE IF NOT EXISTS chat (
    chat_id TEXT PRIMARY KEY NOT NULL,
    chat_type INTEGER NOT NULL,
    name TEXT,
    avatar TEXT,
    creator TEXT,
    member_count INTEGER DEFAULT 0,
    max_seq INTEGER DEFAULT 0,
    notice TEXT,
    muted_all INTEGER DEFAULT 0
);

-- 群成员
CREATE TABLE IF NOT EXISTS member (
    chat_id TEXT NOT NULL,
    uid TEXT NOT NULL,
    role INTEGER DEFAULT 0,
    nickname TEXT,
    joined_at INTEGER DEFAULT 0,
    PRIMARY KEY (chat_id, uid)
);

-- 终端用户只读的组织目录。组织单元全量常驻内存；成员只在选中节点时按 unit_id 载入。
-- OrganizationMember.user 随直属关系快照持久化，避免离线目录依赖另一张用户投影恰好已加载。
CREATE TABLE IF NOT EXISTS organization_unit (
    unit_id TEXT PRIMARY KEY NOT NULL,
    parent_id TEXT,
    name TEXT NOT NULL,
    leader_uid TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0,
    group_chat_id TEXT,
    status INTEGER NOT NULL DEFAULT 1,
    direct_member_count INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS organization_member (
    unit_id TEXT NOT NULL,
    uid TEXT NOT NULL,
    title TEXT,
    is_primary INTEGER NOT NULL DEFAULT 0,
    joined_at INTEGER NOT NULL DEFAULT 0,
    user_username TEXT,
    user_name TEXT,
    user_avatar_path TEXT,
    user_avatar_name TEXT,
    user_avatar_content_type TEXT,
    user_avatar_size INTEGER,
    user_phone TEXT,
    user_sex INTEGER,
    user_role INTEGER,
    user_status INTEGER,
    user_revision INTEGER,
    CHECK(
        (user_username IS NULL AND user_name IS NULL AND user_revision IS NULL) OR
        (user_username IS NOT NULL AND user_name IS NOT NULL AND user_revision > 0)
    ),
    CHECK(
        (user_avatar_path IS NULL AND user_avatar_name IS NULL AND user_avatar_content_type IS NULL AND user_avatar_size IS NULL) OR
        (user_avatar_path IS NOT NULL AND user_avatar_name IS NOT NULL AND user_avatar_content_type IS NOT NULL AND user_avatar_size >= 0)
    ),
    PRIMARY KEY (unit_id, uid)
);
CREATE INDEX IF NOT EXISTS idx_organization_member_unit_joined
ON organization_member(unit_id, joined_at, uid);

-- One row owns the monotonic organization revision boundary. Rows from an older snapshot remain
-- readable for local-first rendering, but callers only treat them as authoritative when their
-- snapshot revision reaches required_revision.
CREATE TABLE IF NOT EXISTS organization_projection_state (
    singleton INTEGER PRIMARY KEY NOT NULL CHECK(singleton = 1),
    required_revision INTEGER NOT NULL DEFAULT 0 CHECK(required_revision >= 0),
    unit_snapshot_revision INTEGER NOT NULL DEFAULT 0 CHECK(unit_snapshot_revision >= 0),
    unit_snapshot_known INTEGER NOT NULL DEFAULT 0 CHECK(unit_snapshot_known IN (0, 1))
);

-- A row means the direct-member list for this unit completed an authoritative read at revision.
-- It deliberately survives both an empty result and later invalidation so stale rows remain useful
-- for offline display without being mistaken for a complete current-revision snapshot.
CREATE TABLE IF NOT EXISTS organization_member_snapshot (
    unit_id TEXT PRIMARY KEY NOT NULL,
    revision INTEGER NOT NULL DEFAULT 0 CHECK(revision >= 0)
);

-- Enterprise documents are a bounded clean server projection. Every tree row is a document node;
-- there is deliberately no folder discriminator. A node may have both a cached body and children.
CREATE TABLE IF NOT EXISTS document_space (
    space_id TEXT PRIMARY KEY NOT NULL CHECK(length(space_id) BETWEEN 1 AND 128),
    position INTEGER NOT NULL CHECK(position >= 0),
    name TEXT NOT NULL,
    description TEXT,
    my_role INTEGER NOT NULL,
    created_by TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    owner_principal_type INTEGER NOT NULL CHECK(owner_principal_type IN (1, 2)),
    owner_principal_id TEXT NOT NULL,
    steward_uid TEXT NOT NULL,
    custody_revision INTEGER NOT NULL CHECK(custody_revision > 0),
    policy_revision INTEGER NOT NULL CHECK(policy_revision > 0)
);
CREATE UNIQUE INDEX IF NOT EXISTS idx_document_space_position
ON document_space(position);

-- 1=complete visible-space snapshot, 2=recent home, 3=recently-created home. A row is retained for
-- an authoritative empty snapshot and removed only by the server-projection reset.
CREATE TABLE IF NOT EXISTS document_projection_marker (
    projection INTEGER PRIMARY KEY NOT NULL CHECK(projection IN (1, 2, 3))
);

-- parent_key is the canonical branch identity: an empty key represents the root branch. The
-- marker survives an authoritative empty response, distinguishing it from an unfetched branch.
CREATE TABLE IF NOT EXISTS document_branch (
    space_id TEXT NOT NULL CHECK(length(space_id) BETWEEN 1 AND 128),
    parent_key TEXT NOT NULL CHECK(length(parent_key) <= 128),
    PRIMARY KEY (space_id, parent_key)
);

-- Sibling order is the immutable service tuple (created_at, node_id), not a second mutable rank.
CREATE TABLE IF NOT EXISTS document_node (
    space_id TEXT NOT NULL CHECK(length(space_id) BETWEEN 1 AND 128),
    node_id TEXT NOT NULL CHECK(length(node_id) BETWEEN 1 AND 128),
    parent_key TEXT NOT NULL CHECK(length(parent_key) <= 128),
    has_children INTEGER NOT NULL CHECK(has_children IN (0, 1)),
    name TEXT NOT NULL,
    excerpt TEXT NOT NULL,
    revision INTEGER NOT NULL CHECK(revision > 0),
    created_by TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_by TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (space_id, node_id)
);
CREATE INDEX IF NOT EXISTS idx_document_node_branch_order
ON document_node(space_id, parent_key, created_at, node_id);

-- collection: 1=recently accessed, 2=recently created. Each collection is a complete bounded
-- snapshot; position preserves the service's deterministic rank.
CREATE TABLE IF NOT EXISTS document_home_item (
    collection INTEGER NOT NULL CHECK(collection IN (1, 2)),
    position INTEGER NOT NULL CHECK(position >= 0),
    document_id TEXT NOT NULL CHECK(length(document_id) BETWEEN 1 AND 128),
    space_id TEXT NOT NULL CHECK(length(space_id) BETWEEN 1 AND 128),
    space_name TEXT NOT NULL,
    title TEXT NOT NULL,
    excerpt TEXT NOT NULL,
    created_by TEXT NOT NULL,
    creator_name TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    accessed_at INTEGER NOT NULL,
    PRIMARY KEY (collection, position)
);
CREATE INDEX IF NOT EXISTS idx_document_home_identity
ON document_home_item(collection, space_id, document_id);

-- Only clean server bodies belong here. Editor drafts use their independent dataset/account-scoped
-- store. cache_ordinal implements deterministic LRU without depending on wall-clock quality.
CREATE TABLE IF NOT EXISTS document_body (
    space_id TEXT NOT NULL CHECK(length(space_id) BETWEEN 1 AND 128),
    document_id TEXT NOT NULL CHECK(length(document_id) BETWEEN 1 AND 128),
    parent_id TEXT CHECK(parent_id IS NULL OR length(parent_id) BETWEEN 1 AND 128),
    title TEXT NOT NULL,
    markdown TEXT NOT NULL,
    asset_manifest BLOB NOT NULL,
    revision INTEGER NOT NULL CHECK(revision > 0),
    created_by TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_by TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    body_bytes INTEGER NOT NULL CHECK(body_bytes >= 0),
    cache_ordinal INTEGER NOT NULL CHECK(cache_ordinal > 0),
    PRIMARY KEY (space_id, document_id)
);
CREATE INDEX IF NOT EXISTS idx_document_body_lru
ON document_body(cache_ordinal, space_id, document_id);

CREATE TABLE IF NOT EXISTS document_body_ancestor (
    space_id TEXT NOT NULL,
    document_id TEXT NOT NULL,
    position INTEGER NOT NULL CHECK(position >= 0),
    ancestor_id TEXT NOT NULL CHECK(length(ancestor_id) BETWEEN 1 AND 128),
    PRIMARY KEY (space_id, document_id, position)
);
CREATE INDEX IF NOT EXISTS idx_document_body_ancestor_identity
ON document_body_ancestor(space_id, document_id, position);

-- 消息
CREATE TABLE IF NOT EXISTS message (
    chat_id TEXT NOT NULL,
    client_msg_id TEXT NOT NULL,
    server_seq INTEGER DEFAULT 0,
    sender_uid TEXT NOT NULL,
    message_type INTEGER NOT NULL,
    timestamp INTEGER NOT NULL,
    flags INTEGER DEFAULT 0,
    body BLOB,
    send_status INTEGER DEFAULT 0,
    -- Stable recovery authority only; raw ACK/transport diagnostics stay in outgoing_message.
    outgoing_failure_code INTEGER CHECK(
        outgoing_failure_code IS NULL OR outgoing_failure_code BETWEEN 1 AND 12
    ),
    PRIMARY KEY (chat_id, client_msg_id)
);
CREATE INDEX IF NOT EXISTS idx_message_chat_seq ON message(chat_id, server_seq);
-- Recovery touches only bounded optimistic rows and the exceptional authoritative rows whose
-- local send status is stale; normal authoritative history does not enter either index.
CREATE INDEX IF NOT EXISTS idx_message_optimistic_status
ON message(send_status, chat_id, client_msg_id, sender_uid)
WHERE server_seq = 0;
CREATE INDEX IF NOT EXISTS idx_message_authoritative_unsent
ON message(chat_id, client_msg_id, sender_uid)
WHERE server_seq > 0 AND send_status != 0;

-- 客户端发送事实源。payload 是入队时规范化后的完整 Message protobuf，之后不可改写。
-- state: 0=PENDING, 1=IN_FLIGHT, 2=RETRY_WAIT, 3=TERMINAL_FAILED, 4=SUCCESS。
-- SUCCESS / TERMINAL_FAILED 是合并有界的诊断回执；GC 绝不删除 active 状态。
CREATE TABLE IF NOT EXISTS outgoing_message (
    local_ordinal INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    client_msg_id TEXT NOT NULL,
    chat_id TEXT NOT NULL,
    sender_uid TEXT NOT NULL,
    payload BLOB NOT NULL,
    request_fingerprint BLOB CHECK(
        request_fingerprint IS NULL OR length(request_fingerprint) BETWEEN 1 AND 64
    ),
    state INTEGER NOT NULL DEFAULT 0,
    attempt_count INTEGER NOT NULL DEFAULT 0,
    failure_code INTEGER CHECK(failure_code IS NULL OR failure_code BETWEEN 1 AND 12),
    last_error TEXT CHECK(last_error IS NULL OR length(last_error) <= 1000),
    terminal_code INTEGER,
    server_seq INTEGER,
    next_attempt_at INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    completed_at INTEGER,
    UNIQUE(chat_id, client_msg_id)
);
CREATE INDEX IF NOT EXISTS idx_outgoing_ready
ON outgoing_message(state, next_attempt_at, local_ordinal);

-- 表情回应（CLIENT-05）的行级服务端投影。每行是 (chat, seq, emoji, uid) 的权威 delta 或
-- 快照结果；聚合计数在展示层由行派生，权威数字永远来自服务端 MessageReactionSummary。
-- 行只随消息保留窗口存在；消息被权威保留策略回收时，对应回应行一并回收。
CREATE TABLE IF NOT EXISTS message_reaction (
    chat_id TEXT NOT NULL,
    server_seq INTEGER NOT NULL CHECK(server_seq > 0),
    emoji TEXT NOT NULL CHECK(length(emoji) BETWEEN 1 AND 64),
    uid TEXT NOT NULL CHECK(length(uid) BETWEEN 1 AND 36),
    PRIMARY KEY (chat_id, server_seq, emoji, uid)
);
CREATE INDEX IF NOT EXISTS idx_message_reaction_chat_seq ON message_reaction(chat_id, server_seq);

-- GUI 建群命令是账号级单槽本地可靠事实。固定主键从 schema 上防止未知结果无界积累；
-- operation_id + 完整规范 payload 在 RPC 前一次发布，新意图原子替换旧意图。
CREATE TABLE IF NOT EXISTS pending_group_creation (
    singleton_id INTEGER PRIMARY KEY NOT NULL CHECK(singleton_id = 1),
    operation_id TEXT NOT NULL CHECK(length(operation_id) = 36),
    creator_uid TEXT NOT NULL CHECK(length(creator_uid) BETWEEN 1 AND 36),
    name TEXT NOT NULL CHECK(length(name) BETWEEN 1 AND 200),
    avatar TEXT CHECK(avatar IS NULL OR length(avatar) BETWEEN 1 AND 500),
    member_uids TEXT NOT NULL CHECK(length(member_uids) BETWEEN 1 AND 36999)
);

-- Unknown-result social commands are bounded local outboxes. The immutable payload and UUID are
-- installed in one SQLite transaction before the first RPC; successful exact responses delete the
-- matching generation. A different decision/payload cannot replace an ambiguous command.
CREATE TABLE IF NOT EXISTS pending_contact_decision (
    operation_id TEXT PRIMARY KEY NOT NULL CHECK(length(operation_id) = 36),
    token TEXT NOT NULL UNIQUE CHECK(length(token) = 36),
    decision INTEGER NOT NULL CHECK(decision IN (1, 2)),
    created_at INTEGER NOT NULL CHECK(created_at >= 0)
);
CREATE INDEX IF NOT EXISTS idx_pending_contact_decision_created
ON pending_contact_decision(created_at, operation_id);

CREATE TABLE IF NOT EXISTS pending_invite_link_creation (
    operation_id TEXT PRIMARY KEY NOT NULL CHECK(length(operation_id) = 36),
    chat_id TEXT NOT NULL UNIQUE CHECK(length(chat_id) = 36),
    name TEXT NOT NULL CHECK(length(name) <= 200),
    max_uses INTEGER NOT NULL CHECK(max_uses >= 0),
    expires_at INTEGER NOT NULL CHECK(expires_at >= 0),
    created_at INTEGER NOT NULL CHECK(created_at >= 0)
);
CREATE INDEX IF NOT EXISTS idx_pending_invite_creation_created
ON pending_invite_link_creation(created_at, operation_id);

-- Group-file mutations can commit even when their response is lost. The full
-- immutable descriptor is deployment/account scoped by the database filename and is admitted
-- before RPC. `intent_key` prevents a second generation from replacing an ambiguous resource.
CREATE TABLE IF NOT EXISTS pending_group_file_command (
    command_id TEXT PRIMARY KEY NOT NULL CHECK(length(command_id) = 36),
    intent_key TEXT NOT NULL UNIQUE CHECK(length(intent_key) BETWEEN 1 AND 512),
    command_kind INTEGER NOT NULL CHECK(command_kind IN (1, 2, 3, 4, 5)),
    entry_id TEXT NOT NULL CHECK(length(entry_id) = 36),
    chat_id TEXT NOT NULL CHECK(length(chat_id) = 36),
    parent_id TEXT CHECK(parent_id IS NULL OR length(parent_id) = 36),
    name TEXT CHECK(name IS NULL OR length(name) BETWEEN 1 AND 180),
    attachment_path TEXT CHECK(attachment_path IS NULL OR length(attachment_path) BETWEEN 1 AND 4096),
    attachment_name TEXT CHECK(attachment_name IS NULL OR length(attachment_name) BETWEEN 1 AND 512),
    attachment_content_type TEXT CHECK(
        attachment_content_type IS NULL OR length(attachment_content_type) BETWEEN 1 AND 255
    ),
    attachment_size INTEGER CHECK(attachment_size IS NULL OR attachment_size BETWEEN 0 AND 536870912),
    expected_revision INTEGER CHECK(expected_revision IS NULL OR expected_revision > 0),
    created_at INTEGER NOT NULL CHECK(created_at >= 0),
    payload_bytes INTEGER NOT NULL CHECK(payload_bytes BETWEEN 1 AND 24576),
    CHECK(
        (command_kind = 1 AND name IS NOT NULL AND
            attachment_path IS NULL AND attachment_name IS NULL AND
            attachment_content_type IS NULL AND attachment_size IS NULL AND expected_revision IS NULL) OR
        (command_kind = 2 AND name IS NOT NULL AND
            attachment_path IS NOT NULL AND attachment_name IS NOT NULL AND
            attachment_content_type IS NOT NULL AND attachment_size IS NOT NULL AND expected_revision IS NULL) OR
        (command_kind = 3 AND parent_id IS NULL AND name IS NULL AND
            attachment_path IS NOT NULL AND attachment_name IS NOT NULL AND
            attachment_content_type IS NOT NULL AND attachment_size IS NOT NULL AND expected_revision IS NOT NULL) OR
        (command_kind = 4 AND name IS NOT NULL AND
            attachment_path IS NULL AND attachment_name IS NULL AND
            attachment_content_type IS NULL AND attachment_size IS NULL AND expected_revision IS NOT NULL) OR
        (command_kind = 5 AND name IS NULL AND
            attachment_path IS NULL AND attachment_name IS NULL AND
            attachment_content_type IS NULL AND attachment_size IS NULL AND expected_revision IS NOT NULL)
    )
);
CREATE INDEX IF NOT EXISTS idx_pending_group_file_command_created
ON pending_group_file_command(created_at, command_id);

-- A document node has one unresolved structural command slot. The complete immutable payload is
-- committed before RPC; operation_id and issued_at are then replayed verbatim after restart.
CREATE TABLE IF NOT EXISTS pending_document_move_command (
    operation_id TEXT PRIMARY KEY NOT NULL CHECK(length(operation_id) = 36),
    space_id TEXT NOT NULL CHECK(length(space_id) = 36),
    node_id TEXT NOT NULL CHECK(length(node_id) = 36),
    old_parent_id TEXT CHECK(old_parent_id IS NULL OR length(old_parent_id) = 36),
    target_parent_id TEXT CHECK(target_parent_id IS NULL OR length(target_parent_id) = 36),
    name TEXT NOT NULL CHECK(length(name) BETWEEN 1 AND 180),
    expected_revision INTEGER NOT NULL CHECK(expected_revision > 0),
    issued_at INTEGER NOT NULL CHECK(issued_at >= 0),
    UNIQUE(space_id, node_id),
    CHECK(node_id <> target_parent_id)
);
CREATE INDEX IF NOT EXISTS idx_pending_document_move_issued
ON pending_document_move_command(issued_at, operation_id);

-- 群机器人创建/轮换共享一个账号级可靠槽。webhook_token 是客户端持有的唯一可恢复副本；
-- 服务器只接收它并保存 SHA-256。仅用户确认保存、服务端证明 Token 已终止，或用户风险确认
-- 后显式放弃恢复时，才可删除这一行；网络/超时/权限/5xx 不得自动清理。
CREATE TABLE IF NOT EXISTS pending_group_bot_credential_command (
    singleton_id INTEGER PRIMARY KEY NOT NULL CHECK(singleton_id = 1),
    operation_id TEXT NOT NULL CHECK(length(operation_id) = 36),
    owner_uid TEXT NOT NULL CHECK(length(owner_uid) BETWEEN 1 AND 64),
    command_kind INTEGER NOT NULL CHECK(command_kind IN (1, 2)),
    chat_id TEXT NOT NULL CHECK(length(chat_id) BETWEEN 1 AND 64),
    bot_id TEXT CHECK(bot_id IS NULL OR length(bot_id) BETWEEN 1 AND 64),
    name TEXT CHECK(name IS NULL OR length(name) BETWEEN 1 AND 100),
    webhook_token TEXT NOT NULL CHECK(length(webhook_token) = 47 AND substr(webhook_token, 1, 4) = 'ttb_'),
    CHECK(
        (command_kind = 1 AND bot_id IS NULL AND name IS NOT NULL) OR
        (command_kind = 2 AND bot_id IS NOT NULL AND name IS NULL)
    )
);

-- 会话
CREATE TABLE IF NOT EXISTS conversation (
    chat_id TEXT PRIMARY KEY NOT NULL,
    chat_type INTEGER NOT NULL,
    peer_uid TEXT,
    peer_revision INTEGER,
    chat_name TEXT,
    chat_avatar_path TEXT,
    chat_avatar_name TEXT,
    chat_avatar_content_type TEXT,
    chat_avatar_size INTEGER,
    last_message TEXT,
    last_message_type INTEGER,
    last_msg_timestamp INTEGER,
    last_seq INTEGER DEFAULT 0,
    read_seq INTEGER DEFAULT 0,
    peer_read_seq INTEGER DEFAULT 0,
    unread_count INTEGER DEFAULT 0,
    is_pinned INTEGER DEFAULT 0,
    is_muted INTEGER DEFAULT 0,
    draft TEXT,
    CHECK(peer_revision IS NULL OR peer_revision > 0),
    CHECK(
        (chat_avatar_path IS NULL AND chat_avatar_name IS NULL AND chat_avatar_content_type IS NULL AND chat_avatar_size IS NULL) OR
        (chat_avatar_path IS NOT NULL AND chat_avatar_name IS NOT NULL AND chat_avatar_content_type IS NOT NULL AND chat_avatar_size >= 0)
    )
);

-- 草稿本地写入与服务端镜像之间的持久化 outbox。
-- 表中无行：服务端草稿可以正常进入本地；有行且 draft IS NULL：用户明确清空。
-- state 0=PENDING（待 RPC），1=ACKED（RPC 成功，等待匹配的权威快照后清理）。
CREATE TABLE IF NOT EXISTS conversation_draft_outbox (
    chat_id TEXT PRIMARY KEY NOT NULL,
    draft TEXT,
    generation INTEGER NOT NULL,
    state INTEGER NOT NULL DEFAULT 0
);

-- 已读水位是单调的本地优先操作。界面先推进 conversation，再由连接恢复任务镜像到服务端；
-- RPC 成功只能条件确认不大于该 ACK 的水位，不能删除请求期间产生的更新水位。
CREATE TABLE IF NOT EXISTS conversation_read_outbox (
    chat_id TEXT PRIMARY KEY NOT NULL,
    read_seq INTEGER NOT NULL CHECK(read_seq > 0)
);

-- 当前账号的服务端投影检查点。dataset identity 与 cursor 必须同一行、同一事务提交；
-- 旧连接只能在 dataset_id 仍匹配时推进 cursor。
CREATE TABLE IF NOT EXISTS sync_state (
    singleton_id INTEGER PRIMARY KEY NOT NULL CHECK(singleton_id = 1),
    dataset_id TEXT NOT NULL CHECK(length(dataset_id) BETWEEN 1 AND 64),
    cursor INTEGER NOT NULL CHECK(cursor >= 0)
);

-- 无头客户端的持久业务 inbox。event_id 保持投递顺序；ACK 行回收后，独立 metadata
-- retained floor 继续承担已退休 event id 的重放幂等边界。
CREATE TABLE IF NOT EXISTS bot_message_inbox (
    event_id INTEGER PRIMARY KEY NOT NULL,
    chat_id TEXT NOT NULL,
    server_seq INTEGER NOT NULL CHECK(server_seq > 0),
    payload BLOB NOT NULL,
    acked INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    acked_at INTEGER
);
CREATE TABLE IF NOT EXISTS bot_inbox_metadata (
    singleton_id INTEGER PRIMARY KEY NOT NULL CHECK(singleton_id = 1),
    retained_floor_event_id INTEGER NOT NULL DEFAULT 0 CHECK(retained_floor_event_id >= 0)
);
-- CREATE / EDIT / REVOKE events deliberately reuse the same chat/server sequence. event_id is
-- the replay-idempotency key; this index only accelerates chat-scoped diagnostics and cleanup.
CREATE INDEX IF NOT EXISTS idx_bot_inbox_message ON bot_message_inbox(chat_id, server_seq);
-- ACK history retention walks one bounded newest prefix; pending delivery lookup uses the same
-- leading state column and remains ordered by the global event cursor.
CREATE INDEX IF NOT EXISTS idx_bot_inbox_ack_event ON bot_message_inbox(acked, event_id DESC);

-- 查询
selectUserByUid:
SELECT * FROM user WHERE uid = ?;

-- eventId=0 的全局 USER_UPDATED 只允许收敛本账号已经持有的产品关系。判断与后续
-- upsert 共享 LocalCache stateLock，避免查询后关系被移除的 TOCTOU 窗口。
isUserLocallyRelevant:
SELECT CASE WHEN
    EXISTS(SELECT 1 FROM user WHERE uid = :uid) OR
    EXISTS(SELECT 1 FROM contact WHERE friend_uid = :uid) OR
    EXISTS(SELECT 1 FROM conversation WHERE peer_uid = :uid) OR
    EXISTS(SELECT 1 FROM member WHERE uid = :uid) OR
    EXISTS(SELECT 1 FROM organization_member WHERE uid = :uid)
THEN 1 ELSE 0 END;

upsertUser:
INSERT OR REPLACE INTO user(
    uid, username, name, avatar_path, avatar_name, avatar_content_type, avatar_size,
    phone, sex, role, status, revision
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- 联系人是当前产品唯一显式全量常驻的实体投影。一次联表构造展示摘要，避免
-- cache 打开时先加载整张 user 表，或再为每位联系人执行一次主键查询。
selectContactsWithUsers:
SELECT
    contact.uid AS contact_owner_uid,
    contact.friend_uid AS contact_friend_uid,
    contact.remark AS contact_remark,
    contact.status AS contact_status,
    user.uid AS user_uid,
    user.username AS user_username,
    user.name AS user_name,
    user.avatar_path AS user_avatar_path,
    user.avatar_name AS user_avatar_name,
    user.avatar_content_type AS user_avatar_content_type,
    user.avatar_size AS user_avatar_size,
    user.phone AS user_phone,
    user.sex AS user_sex,
    user.role AS user_role,
    user.status AS user_status,
    user.revision AS user_revision
FROM contact
LEFT JOIN user ON user.uid = contact.friend_uid
WHERE contact.status = 1
ORDER BY contact.friend_uid ASC;

upsertContact:
INSERT OR REPLACE INTO contact(uid, friend_uid, remark, status)
VALUES (?, ?, ?, ?);

deleteContact:
DELETE FROM contact WHERE friend_uid = ?;

deleteAllContacts:
DELETE FROM contact;

selectChatById:
SELECT * FROM chat WHERE chat_id = ?;

upsertChat:
INSERT OR REPLACE INTO chat(chat_id, chat_type, name, avatar, creator, member_count, max_seq, notice, muted_all)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteChat:
DELETE FROM chat WHERE chat_id = ?;

-- 群成员只在精确读取或观察一个 chat 时联表装配 User 摘要。没有任何查询会在
-- cache 启动时遍历 chat 再逐群读取成员。
selectMembersWithUsersByChat:
SELECT
    member.chat_id AS member_chat_id,
    member.uid AS member_uid,
    member.role AS member_role,
    member.nickname AS member_nickname,
    member.joined_at AS member_joined_at,
    user.uid AS user_uid,
    user.username AS user_username,
    user.name AS user_name,
    user.avatar_path AS user_avatar_path,
    user.avatar_name AS user_avatar_name,
    user.avatar_content_type AS user_avatar_content_type,
    user.avatar_size AS user_avatar_size,
    user.phone AS user_phone,
    user.sex AS user_sex,
    user.role AS user_role,
    user.status AS user_status,
    user.revision AS user_revision
FROM member
LEFT JOIN user ON user.uid = member.uid
WHERE member.chat_id = ?
ORDER BY member.joined_at ASC, member.uid ASC;

selectMemberWithUser:
SELECT
    member.chat_id AS member_chat_id,
    member.uid AS member_uid,
    member.role AS member_role,
    member.nickname AS member_nickname,
    member.joined_at AS member_joined_at,
    user.uid AS user_uid,
    user.username AS user_username,
    user.name AS user_name,
    user.avatar_path AS user_avatar_path,
    user.avatar_name AS user_avatar_name,
    user.avatar_content_type AS user_avatar_content_type,
    user.avatar_size AS user_avatar_size,
    user.phone AS user_phone,
    user.sex AS user_sex,
    user.role AS user_role,
    user.status AS user_status,
    user.revision AS user_revision
FROM member
LEFT JOIN user ON user.uid = member.uid
WHERE member.chat_id = ? AND member.uid = ?;

upsertMember:
INSERT OR REPLACE INTO member(chat_id, uid, role, nickname, joined_at)
VALUES (?, ?, ?, ?, ?);

removeMember:
DELETE FROM member WHERE chat_id = ? AND uid = ?;

deleteMembersByChat:
DELETE FROM member WHERE chat_id = ?;

selectAllOrganizationUnits:
SELECT * FROM organization_unit
ORDER BY sort_order ASC, name ASC, unit_id ASC;

upsertOrganizationUnit:
INSERT OR REPLACE INTO organization_unit(
    unit_id, parent_id, name, leader_uid, sort_order, group_chat_id, status, direct_member_count
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteOrganizationUnit:
DELETE FROM organization_unit WHERE unit_id = ?;

deleteAllOrganizationUnits:
DELETE FROM organization_unit;

updateOrganizationUnitDirectMemberCount:
UPDATE organization_unit SET direct_member_count = ? WHERE unit_id = ?;

selectOrganizationMembersByUnit:
SELECT * FROM organization_member
WHERE unit_id = ?
ORDER BY joined_at ASC, uid ASC;

selectAllOrganizationMembersForCheckpoint:
SELECT * FROM organization_member
ORDER BY unit_id ASC, joined_at ASC, uid ASC;

-- Recursive offline ACL fallback reads a bounded set of unit projections in batches. The caller
-- keeps each IN-list below the oldest supported SQLite bind-variable limit and passes the
-- remaining global relation budget plus one so a corrupt/oversized cache fails closed without
-- materializing an unbounded result.
selectOrganizationMembersByUnits:
SELECT * FROM organization_member
WHERE unit_id IN ?
ORDER BY unit_id ASC, joined_at ASC, uid ASC
LIMIT ?;

upsertOrganizationMember:
INSERT OR REPLACE INTO organization_member(
    unit_id, uid, title, is_primary, joined_at,
    user_username, user_name,
    user_avatar_path, user_avatar_name, user_avatar_content_type, user_avatar_size,
    user_phone, user_sex, user_role, user_status, user_revision
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateOrganizationMemberUser:
UPDATE organization_member SET
    user_username = ?,
    user_name = ?,
    user_avatar_path = ?,
    user_avatar_name = ?,
    user_avatar_content_type = ?,
    user_avatar_size = ?,
    user_phone = ?,
    user_sex = ?,
    user_role = ?,
    user_status = ?,
    user_revision = ?
WHERE uid = ? AND (user_revision IS NULL OR user_revision < ?);

removeOrganizationMember:
DELETE FROM organization_member WHERE unit_id = ? AND uid = ?;

deleteOrganizationMembersByUnit:
DELETE FROM organization_member WHERE unit_id = ?;

deleteOrganizationMembersForUnknownUnits:
DELETE FROM organization_member
WHERE unit_id NOT IN (SELECT unit_id FROM organization_unit);

deleteAllOrganizationMembers:
DELETE FROM organization_member;

countOrganizationMembersByUnit:
SELECT COUNT(*) FROM organization_member WHERE unit_id = ?;

isOrganizationMemberSnapshotCached:
SELECT COUNT(*) FROM organization_member_snapshot WHERE unit_id = ?;

selectOrganizationMemberSnapshotRevision:
SELECT revision FROM organization_member_snapshot WHERE unit_id = ?;

markOrganizationMemberSnapshotCached:
INSERT OR REPLACE INTO organization_member_snapshot(unit_id, revision) VALUES (?, ?);

countOrganizationMemberSnapshots:
SELECT COUNT(*) FROM organization_member_snapshot;

deleteOrganizationMemberSnapshot:
DELETE FROM organization_member_snapshot WHERE unit_id = ?;

deleteOrganizationMemberSnapshotsForUnknownUnits:
DELETE FROM organization_member_snapshot
WHERE unit_id NOT IN (SELECT unit_id FROM organization_unit);

deleteAllOrganizationMemberSnapshots:
DELETE FROM organization_member_snapshot;

selectOrganizationRequiredRevision:
