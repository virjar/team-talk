selectPendingGroupBotCredentialCommand:
SELECT operation_id, owner_uid, command_kind, chat_id, bot_id, name, webhook_token
FROM pending_group_bot_credential_command
WHERE singleton_id = 1;

insertPendingGroupBotCredentialCommand:
INSERT INTO pending_group_bot_credential_command(
    singleton_id, operation_id, owner_uid, command_kind, chat_id, bot_id, name, webhook_token
) VALUES (1, ?, ?, ?, ?, ?, ?, ?);

deletePendingGroupBotCredentialCommand:
