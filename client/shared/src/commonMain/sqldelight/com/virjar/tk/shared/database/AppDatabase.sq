    space_id, node_id, parent_key, has_children, name, excerpt, revision,
    created_by, created_at, updated_by, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateDocumentNodeHasChildren:
UPDATE document_node SET has_children = ? WHERE space_id = ? AND node_id = ?;

deleteDocumentBranch:
DELETE FROM document_branch WHERE space_id = ? AND parent_key = ?;

updateDocumentHomeDocument:
UPDATE document_home_item
SET title = ?, excerpt = ?, updated_at = ?
WHERE space_id = ? AND document_id = ?;

selectDocumentBody:
SELECT * FROM document_body WHERE space_id = ? AND document_id = ?;

selectDocumentBodyAncestors:
