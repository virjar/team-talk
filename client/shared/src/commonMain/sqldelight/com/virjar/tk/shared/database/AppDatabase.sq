    singleton, required_revision, unit_snapshot_revision, unit_snapshot_known
) VALUES (1, ?, ?, ?);

deleteOrganizationProjectionState:
DELETE FROM organization_projection_state;

selectAllDocumentSpaces:
SELECT * FROM document_space ORDER BY position ASC;

-- Every clean projection lane which can keep a server-backed space identity resident. A complete
-- cursor scan freezes this bounded set at request start; only members omitted by its terminal page
-- chain may be purged.
selectDocumentProjectionSpaceIds:
SELECT space_id FROM document_space
UNION SELECT space_id FROM document_home_item
UNION SELECT space_id FROM document_branch
UNION SELECT space_id FROM document_node
UNION SELECT space_id FROM document_body
ORDER BY space_id ASC;

isDocumentProjectionCached:
