WHERE space_id = ? AND document_id = ?
ORDER BY position ASC;

selectDocumentBodyIdsByAncestor:
SELECT DISTINCT document_id FROM document_body_ancestor
WHERE space_id = ? AND ancestor_id = ?;

selectMaxDocumentBodyCacheOrdinal:
SELECT COALESCE(MAX(cache_ordinal), 0) AS max_cache_ordinal FROM document_body;

touchDocumentBody:
UPDATE document_body SET cache_ordinal = ? WHERE space_id = ? AND document_id = ?;

upsertDocumentBody:
INSERT OR REPLACE INTO document_body(
    space_id, document_id, parent_id, title, markdown, asset_manifest, revision, created_by, created_at,
    updated_by, updated_at, body_bytes, cache_ordinal
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertDocumentBodyAncestor:
INSERT INTO document_body_ancestor(space_id, document_id, position, ancestor_id)
VALUES (?, ?, ?, ?);

countDocumentBodies:
SELECT COUNT(*) FROM document_body;

sumDocumentBodyBytes:
SELECT COALESCE(SUM(body_bytes), 0) AS total_body_bytes FROM document_body;

selectOldestDocumentBodyKey:
SELECT space_id, document_id, body_bytes FROM document_body
ORDER BY cache_ordinal ASC, space_id ASC, document_id ASC
LIMIT 1;

deleteDocumentBodyAncestors:
DELETE FROM document_body_ancestor WHERE space_id = ? AND document_id = ?;

deleteDocumentBody:
DELETE FROM document_body WHERE space_id = ? AND document_id = ?;

deleteDocumentNode:
DELETE FROM document_node WHERE space_id = ? AND node_id = ?;

deleteDocumentHomeItem:
DELETE FROM document_home_item WHERE space_id = ? AND document_id = ?;

deleteDocumentHomeBySpace:
DELETE FROM document_home_item WHERE space_id = ?;

deleteDocumentBodyAncestorsBySpace:
