deleteDocumentBranchesBySpace:
DELETE FROM document_branch WHERE space_id = ?;

deleteDocumentBodyAncestorsForUnknownSpaces:
DELETE FROM document_body_ancestor
WHERE NOT EXISTS (
    SELECT 1 FROM document_space WHERE document_space.space_id = document_body_ancestor.space_id
);

deleteDocumentBodiesForUnknownSpaces:
