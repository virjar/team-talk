<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.virjar.tk.android.DebugClipboardAssetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.DEBUG_SET_CLIPBOARD_IMAGE" />
            </intent-filter>
        </receiver>
        <provider
            android:name="com.virjar.tk.android.DebugActivityRecreationProvider"
            android:authorities="${applicationId}.debug-activity-recreation"
            android:exported="false" />
        <receiver
            android:name="com.virjar.tk.android.DebugActivityRecreationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.DEBUG_RECREATE_ACTIVITY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
