*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.swift text eol=lf
*.c text eol=lf
*.h text eol=lf
*.sh text eol=lf
*.properties text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.tsv text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.dylib binary
*.jar binary
*.png binary
*.icns binary
